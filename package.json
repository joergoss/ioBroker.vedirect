{
  "name": "iobroker.vedirect",
  "version": "0.6.0",
  "description": "Robust VE.Direct monitoring with optional validated SmartSolar control",
  "author": {
    "name": "DutchmanNL",
    "email": "rdrozda@hotmail.com"
  },
  "contributors": [
    {
      "name": "Andiling"
    },
    {
      "name": "joerg"
    }
  ],
  "homepage": "https://github.com/joergoss/ioBroker.vedirect",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "energy",
    "connection",
    "pv",
    "solar",
    "victron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joergoss/ioBroker.vedirect.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.20.5",
    "ioredis": "^6.0.0",
    "playwright-core": "^1.65.1",
    "proxyquire": "^2.1.3",
    "typescript": "~5.9.3"
  },
  "files": [
    "admin/",
    "lib/",
    "docs/",
    "tools/",
    "main.js",
    "io-package.json",
    "LICENSE"
  ],
  "main": "main.js",
  "scripts": {
    "test:js": "node node_modules/@iobroker/testing/node_modules/mocha/bin/mocha.js",
    "test:package": "node node_modules/@iobroker/testing/node_modules/mocha/bin/mocha.js test/package --exit",
    "test:integration": "node node_modules/@iobroker/testing/node_modules/mocha/bin/mocha.js test/integration --exit",
    "test:admin:setup": "npx --yes --package=@iobroker/dev-server dev-server setup --adminPort 8081 --admin 7.6.20 --jsController 6.0.11 --symlinks",
    "test:admin:upload": "npx --yes --package=@iobroker/dev-server dev-server upload",
    "test:admin": "npm run test:admin:setup && npm run test:admin:upload && node test/admin-e2e/run.js",
    "dev-server": "npx --yes --package=@iobroker/dev-server dev-server",
    "test": "npm run test:js && npm run test:package",
    "test:all": "npm test && npm run check && npm run lint && npm run test:integration",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "release-script --all --branchPattern '*'",
    "release-dry": "release-script --all --dry",
    "translate": "translate-adapter",
    "build": "echo 'No build required - pure JavaScript project'"
  },
  "overrides": {
    "mocha": {
      "glob": "14.0.6",
      "minimatch": "11.0.9",
      "diff": "8.0.3",
      "serialize-javascript": "7.1.4"
    },
    "@iobroker/adapter-dev": {
      "rimraf": "6.1.4"
    },
    "google-gax": {
      "rimraf": "6.1.4"
    },
    "@eslint/eslintrc": {
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "zod": "4.6.7",
    "esbuild": "0.27.2"
  },
  "bugs": {
    "url": "https://github.com/joergoss/ioBroker.vedirect/issues"
  },
  "readmeFilename": "README.md"
}
